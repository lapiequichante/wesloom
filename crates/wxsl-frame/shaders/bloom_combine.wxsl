//! bloom_combine — the foot of a bloom pyramid, and the composite.
//!
//! Reads the assembled glow (the pyramid's final fold, at half this
//! pass's resolution) and the unblurred image, and adds the one back onto
//! the other: `strength` is how much of the glow comes back. The input is
//! *linear radiance* — the glow is light, and the display transform is
//! somebody else's pass (ADR 0039).
//!
//! The glow arrives at half resolution — the pyramid's topmost fold — so
//! this pass performs the ascent's last tent step itself: the same 3×3
//! tent as `bloom_up.wxsl`, which is the average of four bilinear taps at
//! ±½-texel offsets. A plain bilinear here would let the topmost fold's
//! own texel edges show; the tent is what makes the last step read as
//! light rather than as blocks. The pass group binds textures and no
//! sampler, so the step is written by hand; off-edge loads clamp.
//!
//! One fullscreen pass; the two inputs are the two bindings, in the
//! effect descriptor's declaration order. `strength` is a uniform the
//! descriptor declares (ADR 0042); the `pass.bloom` document node seeds
//! it from its own setting and the host re-tunes it live through
//! `set_pass_param` on the pass label the expansion generated.

@group(3) @binding(0) var color_image: texture_2d<f32>;
@group(3) @binding(1) var glow_image: texture_2d<f32>;

@vertex
fn bloom_combine_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle covering the viewport, from three vertices and
    // no vertex buffer: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

/// One bilinear tap of `glow` at `at`, in glow texels — the four
/// surrounding texels, weighted by how far the point falls between them.
fn bilinear_glow(at: vec2f, top: vec2i) -> vec3f {
    let whole = floor(at);
    let fraction = at - whole;
    let lo = clamp(vec2i(whole), vec2i(0, 0), top);
    let hi = clamp(lo + vec2i(1, 1), vec2i(0, 0), top);
    let a = textureLoad(glow_image, vec2i(lo.x, lo.y), 0).rgb;
    let b = textureLoad(glow_image, vec2i(hi.x, lo.y), 0).rgb;
    let c = textureLoad(glow_image, vec2i(lo.x, hi.y), 0).rgb;
    let d = textureLoad(glow_image, vec2i(hi.x, hi.y), 0).rgb;
    return mix(mix(a, b, fraction.x), mix(c, d, fraction.x), fraction.y);
}

@fragment
fn bloom_combine_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let pixel = vec2i(position.xy);
    let base = textureLoad(color_image, pixel, 0).rgb;

    // This pixel's centre, in glow texels: the glow covers half of each
    // axis this pass writes, so the coordinate halves and then steps back
    // half a texel to land between texels rather than on one.
    let glow_size = vec2f(textureDimensions(glow_image));
    let size = vec2f(textureDimensions(color_image));
    let source = (position.xy + vec2f(0.5)) * (glow_size / size) - vec2f(0.5);
    let top = max(vec2i(glow_size) - vec2i(1, 1), vec2i(0, 0));
    // The 3×3 tent, as the average of four bilinear taps at ±½ texel.
    let tent = bilinear_glow(source + vec2f(-0.5, -0.5), top)
        + bilinear_glow(source + vec2f(0.5, -0.5), top)
        + bilinear_glow(source + vec2f(-0.5, 0.5), top)
        + bilinear_glow(source + vec2f(0.5, 0.5), top);
    let glow = tent * 0.25;

    return vec4f(base + glow * params.strength, 1.0);
}
