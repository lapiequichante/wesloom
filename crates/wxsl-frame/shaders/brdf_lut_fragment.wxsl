//! brdf_lut_fragment — the LUT bake's fragment arm (ADR 0075).
//!
//! What a device without compute runs instead of `brdf_lut.wxsl`: one
//! fullscreen triangle over the 64 × 64 target, each fragment storing the
//! texel the compute invocation at the same coordinate would have. A
//! fragment's position is its texel's centre, so `uv` is the compute arm's
//! to the bit, and the integral is the shared one prepended to this file.

@vertex
fn bake_lut_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle covering the viewport, from three vertices and
    // no vertex buffer: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn bake_lut_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    return lut_quadrant_texel(vec2u(position.xy));
}
