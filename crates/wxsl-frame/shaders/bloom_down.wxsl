//! bloom_down — one level of a bloom pyramid's descent.
//!
//! The plain 2×2 box mean that takes level *k* of the pyramid down to
//! level *k + 1*: the same step every mip chain repeats, half the texels
//! each time. No threshold — the bright signal was cut once at the head
//! of the pyramid (`bloom_extract.wxsl`), and cutting again would discard
//! the glow the deeper levels exist to widen.
//!
//! At odd sizes the last row and column clamp onto the edge texel, which
//! weights it; the pyramid's targets round up for exactly this, the same
//! [`Extent`] rule every viewport-scaled resource follows. The pass group
//! binds textures and no sampler, so the loads are whole texels.

@group(3) @binding(0) var image: texture_2d<f32>;

@vertex
fn bloom_down_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle covering the viewport, from three vertices and
    // no vertex buffer: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn bloom_down_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let size = vec2i(textureDimensions(image)) - vec2i(1, 1);
    let base = clamp(vec2i(position.xy) * 2, vec2i(0, 0), size);
    let sum = textureLoad(image, base, 0).rgb
        + textureLoad(image, clamp(base + vec2i(1, 0), vec2i(0, 0), size), 0).rgb
        + textureLoad(image, clamp(base + vec2i(0, 1), vec2i(0, 0), size), 0).rgb
        + textureLoad(image, clamp(base + vec2i(1, 1), vec2i(0, 0), size), 0).rgb;
    return vec4f(sum * 0.25, 1.0);
}
