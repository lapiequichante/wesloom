//! glare_ghosts — a lens flare's ghosts and halo ring, from the bright
//! part of the frame (`effect::glare`).
//!
//! A ghost is light reflected back and forth between a lens' surfaces
//! before it reaches the sensor: a copy of each bright source on the line
//! through the image centre, `f` times as far from it (a negative `f`
//! across it), and `|f|` times its size. So ghost `i` of this pixel shows
//! the image at `centre + (pixel - centre) * squeeze / f`, up to eight of
//! them, their factors in `params.scales_a` and `params.scales_b` (0 for
//! none); `params.squeeze` other than 1 stretches them, as an anamorphic
//! lens does. A ghost's light is spread over its size, so it weighs
//! `1 / f²`, at most `params.brightest`; each is tinted from a fixed
//! palette by `params.tint` (0 white, 1 fully coloured) and its channels
//! are read `params.chroma` apart, red inside, blue outside, as glass
//! disperses. The ghosts fade where their source nears the image's edge,
//! where it would be cut off.
//!
//! Only what is brighter than `params.threshold` makes ghosts, and only
//! its excess over it (eased in over a knee half as wide), so the
//! highlights flare and a lit wall does not, and a higher threshold dims
//! the ghosts of what still passes.
//!
//! The halo ring is the image read `params.ring` of the height towards
//! the centre (Chapman's pseudo lens flare, 2013): a light near the
//! centre draws an arc that far around it. A ring of 0 draws none.
//!
//! The target may have any size, the image another: reads go through the
//! frame's linear, clamped sampler, so the image may be any level of a
//! bloom pyramid, a deeper one giving softer ghosts, drawn into a larger
//! target that filters its texels once more.

import package::wxsl::bindings::environment_lut_sampler;

@group(3) @binding(0) var image: texture_2d<f32>;

struct Screen {
    @builtin(position) position: vec4f,
    /// The target's uv, whatever its size.
    @location(0) uv: vec2f,
}

@vertex
fn vertex(@builtin(vertex_index) index: u32) -> Screen {
    // A fullscreen triangle: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return Screen(vec4f(x, y, 0.0, 1.0), vec2f(x + 1.0, 1.0 - y) * 0.5);
}

/// How much of a source at `at` (uv) reaches a ghost: none past the
/// image's edge, easing in over the outer twentieth.
fn edge(at: vec2f) -> f32 {
    let inside = smoothstep(vec2f(0.0), vec2f(0.05), at) * smoothstep(vec2f(1.0), vec2f(0.95), at);
    return inside.x * inside.y;
}

/// The part of `color` past the threshold, or all of it at none.
fn kept(color: vec3f) -> vec3f {
    if params.threshold <= 0.0 {
        return color;
    }
    let luminance = dot(color, vec3f(0.2126, 0.7152, 0.0722));
    let knee = params.threshold * 0.5;
    let soft = clamp(luminance - params.threshold + knee, 0.0, 2.0 * knee);
    let excess = max(soft * soft / (4.0 * knee), luminance - params.threshold);
    return color * (excess / max(luminance, 1e-6));
}

/// The image at `centre + offset`, past the threshold, its red read `chroma` nearer the
/// centre and its blue as much further.
fn dispersed(offset: vec2f, chroma: f32) -> vec3f {
    let centre = vec2f(0.5);
    let red = centre + offset * (1.0 - chroma);
    let blue = centre + offset * (1.0 + chroma);
    let green = centre + offset;
    return vec3f(
        kept(textureSampleLevel(image, environment_lut_sampler, red, 0.0).rgb).r * edge(red),
        kept(textureSampleLevel(image, environment_lut_sampler, green, 0.0).rgb).g * edge(green),
        kept(textureSampleLevel(image, environment_lut_sampler, blue, 0.0).rgb).b * edge(blue),
    );
}

@fragment
fn fragment(screen: Screen) -> @location(0) vec4f {
    let size = vec2f(textureDimensions(image));
    let uv = screen.uv;
    let centre = vec2f(0.5);
    let aspect = vec2f(size.x / size.y, 1.0);
    let scales = array<f32, 8>(
        params.scales_a.x, params.scales_a.y, params.scales_a.z, params.scales_a.w,
        params.scales_b.x, params.scales_b.y, params.scales_b.z, params.scales_b.w,
    );
    var sum = vec3f(0.0);
    for (var i = 0; i < 8; i++) {
        let f = scales[i];
        if abs(f) < 1e-3 {
            continue;
        }
        let offset = (uv - centre) * params.squeeze / f;
        let palette = vec3f(0.55) + 0.45 * cos(6.2831853 * (f32(i) * 0.23 + vec3f(0.0, 0.33, 0.67)));
        let tint = mix(vec3f(1.0), palette, params.tint);
        let weight = min(1.0 / (f * f), params.brightest);
        sum += dispersed(offset, params.chroma) * tint * weight;
    }
    if params.ring > 0.0 {
        // Towards the centre, `ring` of the height, in square texels.
        let away = (uv - centre) * aspect;
        let toward = -away / max(length(away), 1e-4);
        let source = uv + toward * params.ring / aspect;
        let near = saturate(1.0 - length((source - centre) * aspect) / 0.6);
        let ring = dispersed(source - centre, params.chroma * 2.0);
        sum += ring * pow(near, 4.0) * params.ring_strength;
    }
    return vec4f(sum, 1.0);
}
