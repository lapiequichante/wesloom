//! Screen-space reflections on glass (`effect::ssr`): the nearest optical
//! layer, after `refraction` composed it, mirroring the opaque frame.
//!
//! The composition reflects the radiance cube along each layer's mirror
//! ray, Fresnel-weighted (`refraction_layer.wxsl`). Here the front layer's
//! ray is marched against the opaque depth by `package::wxsl::ssr_trace`;
//! where it hits, the opaque frame's radiance there takes the cube's place
//! in that reflection, faded at the frame's edge and towards
//! `params.distance`. Glass is a mirror: nothing is blurred.

import package::wxsl::bindings::{point_sampler, camera, scene, environment_lut_sampler};
import package::wxsl::ssr_trace::{ssr_trace, ssr_fade};

@group(3) @binding(0) var color_image: texture_2d<f32>;
@group(3) @binding(1) var opaque_image: texture_2d<f32>;
@group(3) @binding(2) var depth_image: texture_2d<f32>;
@group(3) @binding(3) var environment: texture_cube<f32>;
@group(3) @binding(4) var normal_layers: texture_2d_array<f32>;
@group(3) @binding(5) var optical_layers: texture_2d_array<f32>;

@vertex
fn vertex(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

// The composition's dielectric Fresnel, unpolarised.
fn fresnel(eta_i: f32, eta_t: f32, cosine: f32) -> f32 {
    let ci = clamp(cosine, 0.0, 1.0);
    let eta = eta_i / eta_t;
    let k = 1.0 - eta * eta * (1.0 - ci * ci);
    if k <= 0.0 { return 1.0; }
    let ct = sqrt(k);
    let rs = (eta_i * ci - eta_t * ct) / max(eta_i * ci + eta_t * ct, 0.000001);
    let rp = (eta_t * ci - eta_i * ct) / max(eta_t * ci + eta_i * ct, 0.000001);
    return clamp(0.5 * (rs * rs + rp * rp), 0.0, 1.0);
}

@fragment
fn fragment(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let pixel = vec2i(position.xy);
    let color = textureLoad(color_image, pixel, 0);
    let size = vec2f(textureDimensions(depth_image));
    let uv = (floor(position.xy) + 0.5) / size;
    let front = textureLoad(normal_layers, pixel, 0, 0);
    let material = textureLoad(optical_layers, pixel, 0, 0);
    let opaque = textureSampleLevel(depth_image, point_sampler, uv, 0.0).x;
    // No glass in front of the opaque frame here.
    if dot(front.xyz, front.xyz) < 0.5 || front.w >= opaque || material.w <= 0.0 || params.strength <= 0.0 {
        return color;
    }

    let ndc = vec4f(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, front.w, 1.0);
    let unprojected = camera.inverse_view_proj * ndc;
    let world = unprojected.xyz / unprojected.w;
    let view = normalize(world - camera.position);
    var normal = normalize(front.xyz);
    // A thin sheet's normal is turned toward the viewer, as the
    // composition turns it; its coverage weighs its reflection.
    var coverage = 1.0;
    if material.r < 0.0 {
        if dot(normal, view) > 0.0 {
            normal = -normal;
        }
        coverage = material.g - 2.0 * floor(material.g * 0.5);
    }
    let ray = reflect(view, normal);
    let hit = ssr_trace(depth_image, world + normal * 0.01, ray, params.distance, vec3f(params.steps, params.stride, params.growth));
    if hit.w <= 0.0 {
        return color;
    }
    let reflected = textureLoad(opaque_image, vec2i(clamp(hit.xy * size, vec2f(0.0), size - 1.0)), 0).rgb;
    let sky = textureSampleLevel(environment, environment_lut_sampler, ray, 0.0).rgb * scene.environment_scale * scene.exposure;
    let f = fresnel(1.0, abs(material.w), -dot(view, normal));
    let fade = ssr_fade(hit.xy, hit.z, params.distance) * coverage;
    let shaded = color.rgb + f * (fade * params.strength) * (reflected - sky);
    return vec4f(max(shaded, vec3f(0.0)), color.a);
}
