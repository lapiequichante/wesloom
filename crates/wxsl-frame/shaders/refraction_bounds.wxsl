@group(3) @binding(0) var depth_image: texture_depth_2d;
@group(3) @binding(1) var previous: texture_2d<f32>;

@vertex
fn vertex(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
    return vec4f(f32(i32(i & 1u) * 4 - 1), f32(i32(i >> 1u) * 4 - 1), 0.0, 1.0);
}

@fragment
fn fragment(@builtin(position) p: vec4f) -> @location(0) vec2f {
    let pixel = vec2i(p.xy);
    let depth = textureLoad(depth_image, pixel, 0);
    return vec2f(select(textureLoad(previous, pixel, 0).r, depth, depth < 1.0), 1.0);
}
