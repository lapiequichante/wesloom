//! brdf_integrate — the split-sum environment-BRDF integral, shared by
//! the LUT bake's two arms.
//!
//! The compute bake (`brdf_lut.wxsl`) and its fragment fallback
//! (`brdf_lut_fragment.wxsl`, ADR 0075) both prepend this file, so the two
//! arms run one integral and agree to the bit. `uv.x` is N·V, `uv.y`
//! roughness; the texel holds the (scale, bias) pair Karis'
//! environment-BRDF approximation reduces to, integrated over a
//! Hammersley sample set.

/// Side of one LUT quadrant, in texels: the frame's LUT is two by two of
/// them, 16 × 16 workgroups of 8 × 8 invocations (ADR 0096).
const LUT_SIZE: u32 = 64u;
/// Samples per texel. Once-only work, so it can afford to be thorough.
const SAMPLE_COUNT: u32 = 1024u;

/// A tangent frame around `n`, any tangent — the integral is rotationally
/// symmetric about the normal, so the frame's twist does not matter.
fn tangent_frame(n: vec3f) -> mat3x3f {
    let up = select(vec3f(0.0, 1.0, 0.0), vec3f(1.0, 0.0, 0.0), abs(n.z) < 0.999);
    let tangent = normalize(cross(up, n));
    let bitangent = cross(n, tangent);
    return mat3x3f(tangent, bitangent, n);
}

/// The (scale, bias) pair for one (N·V, roughness) point: the average of
/// `F0 * scale + bias * F` over the visible hemisphere, which folds the
/// whole environment-BRDF into one 2D lookup.
fn integrate(n: vec3f, v: vec3f, roughness: f32) -> vec2f {
    let alpha = max(roughness * roughness, 1e-3);
    let n_dot_v = max(dot(n, v), 1e-4);
    let basis = tangent_frame(n);

    var sum = vec2f(0.0, 0.0);
    for (var i = 0u; i < SAMPLE_COUNT; i++) {
        // Hammersley point set: even coverage, no RNG, no state.
        let xi = vec2f(f32(i) / f32(SAMPLE_COUNT), radical_inverse(i));
        // The GGX half vector, in the tangent frame.
        let phi = 6.2831853 * xi.x;
        let cos_theta = sqrt((1.0 - xi.y) / (1.0 + (alpha * alpha - 1.0) * xi.y));
        let sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
        let h = basis * vec3f(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);
        let l = 2.0 * dot(v, h) * h - v;

        let n_dot_l = max(dot(n, l), 0.0);
        let n_dot_h = max(dot(n, h), 0.0);
        let v_dot_h = max(dot(v, h), 0.0);
        if (n_dot_l > 0.0) {
            // Smith visibility with the IBL roughness remap.
            let k = alpha * 0.5;
            let g_v = n_dot_v / (n_dot_v * (1.0 - k) + k);
            let g_l = n_dot_l / (n_dot_l * (1.0 - k) + k);
            let fresnel = pow(1.0 - v_dot_h, 5.0);
            // The importance-sampling pdf cancels into this weight.
            let weight = g_v * g_l * n_dot_l / max(n_dot_h * n_dot_v, 1e-4);
            sum += vec2f((1.0 - fresnel) * weight, fresnel * weight);
        }
    }
    return sum / f32(SAMPLE_COUNT);
}

/// The Van der Corput radical inverse of `i`: its bits reversed, as a
/// fraction. Spelled out rather than `reverseBits`, which GLSL ES 3.00
/// lacks (ADR 0075) — the same swaps, so the same value.
fn radical_inverse(i: u32) -> f32 {
    var bits = (i << 16u) | (i >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return f32(bits) / 4294967296.0;
}

/// One LUT texel at texel-centre `uv`, as both arms store it.
fn lut_texel(uv: vec2f) -> vec4f {
    // One canonical geometry: the normal up, the view tilted to N·V.
    let n = vec3f(0.0, 0.0, 1.0);
    let v = vec3f(sqrt(max(0.0, 1.0 - uv.x * uv.x)), 0.0, uv.x);
    return vec4f(integrate(n, v, uv.y), 0.0, 1.0);
}

/// The texel at `texel` of the quadrant layout (ADR 0096): the top left
/// quadrant holds the split-sum pair and the LTC inverse's (00, 02)
/// entries, the top right its (20, 22) entries, both at the same
/// (N·V, roughness); the bottom half is empty. `ltc_table.wxsl` is
/// prepended with this file.
fn lut_quadrant_texel(texel: vec2u) -> vec4f {
    let quadrant = texel / LUT_SIZE;
    let local = texel % LUT_SIZE;
    if quadrant.y > 0u {
        return vec4f(0.0, 0.0, 0.0, 1.0);
    }
    let ltc = LTC_TABLE[local.y * LTC_SIZE + local.x];
    if quadrant.x > 0u {
        return vec4f(ltc.zw, 0.0, 1.0);
    }
    let uv = (vec2f(local) + vec2f(0.5, 0.5)) / f32(LUT_SIZE);
    return vec4f(lut_texel(uv).xy, ltc.xy);
}
