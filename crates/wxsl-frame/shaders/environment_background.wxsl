import package::wxsl::bindings::{camera, scene, environment_lut_sampler};

@group(3) @binding(0) var color_image: texture_2d<f32>;
@group(3) @binding(1) var depth_image: texture_depth_2d;
@group(3) @binding(2) var radiance_image: texture_cube<f32>;

struct VertexOutput {
    @builtin(position) position: vec4f,
    @location(0) uv: vec2f,
}

@vertex
fn vertex(@builtin(vertex_index) index: u32) -> VertexOutput {
    let xy = vec2f(f32(i32(index & 1u) * 4 - 1), f32(i32(index >> 1u) * 4 - 1));
    var out: VertexOutput;
    out.position = vec4f(xy, 0.0, 1.0);
    out.uv = vec2f(xy.x * 0.5 + 0.5, 0.5 - xy.y * 0.5);
    return out;
}

@fragment
fn fragment(input: VertexOutput) -> @location(0) vec4f {
    let uv = input.uv;
    if textureLoad(depth_image, vec2i(uv * vec2f(textureDimensions(depth_image))), 0) < 1.0 {
        return textureLoad(color_image, vec2i(uv * vec2f(textureDimensions(color_image))), 0);
    }
    let xy = vec2f(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    let near = camera.inverse_view_proj * vec4f(xy, 0.0, 1.0);
    let far = camera.inverse_view_proj * vec4f(xy, 0.5, 1.0);
    // Two finite depths also support infinite-far projection matrices.
    let ray = normalize(far.xyz / far.w - near.xyz / near.w);
    let light = textureSampleLevel(radiance_image, environment_lut_sampler, ray, 0.0).rgb;
    return vec4f(light * scene.environment_scale * scene.exposure, 1.0);
}
