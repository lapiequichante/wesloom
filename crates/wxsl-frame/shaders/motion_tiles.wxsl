//! motion_tiles — the motion blur's first reconstruction pass (McGuire et
//! al. 2012, "A Reconstruction Filter for Plausible Motion Blur"): the
//! longest screen motion in each tile of `TILE` pixels.
//!
//! Mounted by `wxsl.motion_tiles`, writing a `pair` target at
//! `1 / TILE` of the frame (`MOTION_TILES_SCALE`), so one fragment is one
//! tile. `wxsl.motion_neighbors` spreads it, and the gather follows it.

@group(3) @binding(0) var velocity_image: texture_2d<f32>;

/// The tile's edge, in pixels: the target's scale is its inverse.
const TILE: i32 = 32;

@vertex
fn motion_tiles_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn motion_tiles_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let size = vec2i(textureDimensions(velocity_image));
    let corner = vec2i(position.xy) * TILE;
    // Longest in pixels, not in uv, which a wide frame stretches.
    let pixels = vec2f(size);
    var longest = vec2f(0.0);
    var reach = 0.0;
    for (var y = 0; y < TILE; y++) {
        for (var x = 0; x < TILE; x++) {
            let pixel = corner + vec2i(x, y);
            if (any(pixel >= size)) {
                continue;
            }
            let motion = textureLoad(velocity_image, pixel, 0).xy;
            let length_here = length(motion * pixels);
            if (length_here > reach) {
                reach = length_here;
                longest = motion;
            }
        }
    }
    return vec4f(longest, 0.0, 1.0);
}
