//! Screen-space reflections (`effect::ssr`): what the opaque frame
//! already shows, reflected by every surface glossy enough to mirror it,
//! in the manner of Babylon's SSR.
//!
//! The G-buffer gives each pixel its normal, roughness, base colour and
//! metalness; the reflected ray is marched by `package::wxsl::ssr_trace`.
//! Where it hits, the frame's radiance there replaces the environment's
//! in the reflection: the lit colour already holds the specular cube's
//! light along the ray, Fresnel-weighted, so it is that which is taken
//! back out. Rougher surfaces fade out by `params.max_roughness` and blur
//! their hit over the ray's cone; rays that leave the frame or go further
//! than `params.distance` fade into the environment's reflection, which is
//! left as it was.

import package::wxsl::bindings::{point_sampler, camera, scene, environment_specular, environment_lut_sampler};
import package::wxsl::gbuffer::gbuffer_decode_normal;
import package::wxsl::ssr_trace::{ssr_trace, ssr_fade};

@group(3) @binding(0) var color_image: texture_2d<f32>;
@group(3) @binding(1) var depth_image: texture_2d<f32>;
@group(3) @binding(2) var normal_image: texture_2d<f32>;
@group(3) @binding(3) var base_image: texture_2d<f32>;

/// The widest the hit is blurred over, pixels.
const MAX_BLUR: f32 = 24.0;

@vertex
fn vertex(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn fragment(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let pixel = vec2i(position.xy);
    let color = textureLoad(color_image, pixel, 0);
    let size = vec2f(textureDimensions(depth_image));
    let uv = (floor(position.xy) + 0.5) / size;
    let depth = textureSampleLevel(depth_image, point_sampler, uv, 0.0).x;
    let packed = textureLoad(normal_image, pixel, 0);
    let roughness = packed.z;
    let gloss = 1.0 - saturate(roughness / max(params.max_roughness, 1e-3));
    if depth >= 1.0 || gloss <= 0.0 || params.strength <= 0.0 {
        return color;
    }

    let ndc = vec4f(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    let unprojected = camera.inverse_view_proj * ndc;
    let world = unprojected.xyz / unprojected.w;
    let normal = gbuffer_decode_normal(packed.xy);
    let view = normalize(world - camera.position);
    let ray = reflect(view, normal);
    // Off the surface, so the first steps do not find the surface itself.
    let hit = ssr_trace(depth_image, world + normal * 0.02, ray, params.distance, vec3f(params.steps, params.stride, params.growth));
    if hit.w <= 0.0 {
        return color;
    }

    // The hit blurred over the ray's cone, wider the rougher and the
    // longer the ray, on a plus of four taps about it.
    let point = world + normal * 0.02 + ray * hit.z;
    let w = (camera.view_proj * vec4f(point, 1.0)).w;
    let blur = min(roughness * 0.5 * hit.z / max(w, 1e-3) * size.y, MAX_BLUR);
    let centre = hit.xy * size;
    var reflected = vec3f(0.0);
    for (var i = 0; i < 5; i++) {
        let angle = f32(i) * 1.5707964 + 0.785;
        let offset = select(vec2f(cos(angle), sin(angle)) * blur, vec2f(0.0), i == 4);
        let tap = vec2i(clamp(centre + offset, vec2f(0.0), size - 1.0));
        reflected += textureLoad(color_image, tap, 0).rgb;
    }
    reflected *= 0.2;

    // What the shading already reflected along the ray: the specular
    // cube at the surface's roughness, as the frame exposes it.
    let levels = f32(textureNumLevels(environment_specular));
    let environment = textureSampleLevel(environment_specular, environment_lut_sampler, ray, roughness * (levels - 1.0)).rgb * scene.environment_scale * scene.exposure;

    let base = textureLoad(base_image, pixel, 0);
    let f0 = mix(vec3f(0.04), base.rgb, base.a);
    let cosine = saturate(dot(normal, -view));
    let fresnel = f0 + (vec3f(1.0) - f0) * pow(1.0 - cosine, 5.0);

    let fade = ssr_fade(hit.xy, hit.z, params.distance) * gloss * gloss;
    let shaded = color.rgb + fresnel * (fade * params.strength) * (reflected - environment);
    return vec4f(max(shaded, vec3f(0.0)), color.a);
}
