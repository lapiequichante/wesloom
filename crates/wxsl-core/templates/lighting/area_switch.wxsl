// Each model's analytic response to an unshadowed rectangle or tube, with
// `w` 1; `w` 0 for a model with none, whose light loop samples the light
// instead (ADR 0096).
fn area_dispatch(surface: ${SURFACE}, ctx: ${CONTEXT}, area: AreaLight${EXTRAS_PARAM}, model_id: u32) -> vec4f {
    switch model_id {
${SWITCH_ARMS}        default: { return vec4f(0.0); }
    }
}

