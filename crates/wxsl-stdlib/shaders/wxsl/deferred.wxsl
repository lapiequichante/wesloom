// The G-buffer: what the deferred path's material pass writes, and what its
// lighting pass reads back.
//
// The layout mirrors `wxsl_core::abi::GBUFFER_TARGETS` — three colour
// attachments, two quantities each — and `wxsl-render` picks the texture
// formats from that same table. Packing pairs keeps the attachment count (and
// therefore the bandwidth) down without compressing anything lossily beyond
// what the format already does.
//
// What is *not* in here is the material's UV and tangent frame: reconstructing
// a full `SurfaceContext` after the fact is impossible without them. That is
// fine, because the material function has already run by then — the lighting
// pass only needs what `shade_surface` reads.

import package::wxsl::surface::Surface;

struct GBuffer {
    // rgb = linear base colour, a = metallic.
    @location(0) base_color: vec4f,
    // rgb = world-space shading normal, a = roughness.
    @location(1) normal: vec4f,
    // rgb = emissive radiance, a = ambient occlusion.
    @location(2) emissive: vec4f,
}

fn pack_gbuffer(surface: Surface) -> GBuffer {
    var out: GBuffer;
    out.base_color = vec4f(surface.base_color, saturate(surface.metallic));
    // The normal target is a float format, so the normal is stored as-is
    // rather than remapped into 0..1 and back.
    out.normal = vec4f(normalize(surface.normal), saturate(surface.roughness));
    out.emissive = vec4f(surface.emissive, saturate(surface.occlusion));
    return out;
}

// Rebuild a `Surface` from three G-buffer texels.
//
// `alpha` comes back as 1: the G-buffer is opaque by construction, since a
// deferred pass has nowhere to put a second surface behind the first.
fn unpack_gbuffer(base_color: vec4f, normal: vec4f, emissive: vec4f) -> Surface {
    var out: Surface;
    out.base_color = base_color.rgb;
    out.metallic = base_color.a;
    out.normal = normalize(normal.xyz);
    out.roughness = normal.a;
    out.emissive = emissive.rgb;
    out.occlusion = emissive.a;
    out.alpha = 1.0;
    return out;
}
