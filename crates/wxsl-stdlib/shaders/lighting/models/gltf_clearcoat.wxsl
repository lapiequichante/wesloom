// The glTF clear-coat lighting model
//
// PBR under a dielectric coat authored the way KHR_materials_clearcoat
// describes it: a strength, a perceptual roughness and a normal of the
// coat's own, all from the surface. The coat reflects with a fixed 4% and
// the layer beneath keeps `1 - strength * Fresnel` of the light, the
// extension's layering. The data rides in the model channel: strength,
// roughness, and the coat normal octahedrally (ADR 0091). Original
// composition over shipped BRDF primitives.
//
// `wxsl.clearcoat` stays as it was: a coat derived from the roughness.
// Not a node: one of the entries of `wxsl_core::lighting::DEFAULT_MODELS`.

import package::lighting::ambient_environment::ambient_environment;
import package::lighting::distribution_ggx::distribution_ggx;
import package::lighting::fresnel_schlick::fresnel_schlick;
import package::lighting::models::pbr::lighting_pbr;
import package::lighting::visibility_smith::visibility_smith;
import package::wxsl::bindings::{
    LightSample,
    scene,
    environment_brdf,
    environment_diffuse_radiance,
    environment_specular_radiance,
};
import package::wxsl::gbuffer::{gbuffer_encode_normal, gbuffer_decode_normal};
import package::wxsl::surface::{Surface, SurfaceContext};

fn pack_gltf_clearcoat(surface: Surface) -> vec4f {
    return vec4f(
        saturate(surface.clearcoat),
        saturate(surface.clearcoat_roughness),
        gbuffer_encode_normal(normalize(surface.clearcoat_normal)),
    );
}

// The share of the light the coat reflects at this view, which the base
// layer never receives.
fn coat_fresnel(coat_normal: vec3f, view_direction: vec3f) -> f32 {
    return fresnel_schlick(vec3f(0.04), saturate(dot(coat_normal, view_direction))).x;
}

fn lighting_gltf_clearcoat(
    surface: Surface,
    ctx: SurfaceContext,
    light: LightSample,
    extra: vec4f, // `pack_gltf_clearcoat`'s texel
) -> vec3f {
    let base = lighting_pbr(surface, ctx, light, extra);
    let strength = extra.x;
    if strength <= 0.0 {
        return base;
    }
    let roughness = extra.y;
    let normal = gbuffer_decode_normal(extra.zw);
    let view_direction = normalize(ctx.view_direction);
    let half_vector = normalize(light.direction + view_direction);
    let n_dot_l = saturate(dot(normal, light.direction));
    let n_dot_v = saturate(dot(normal, view_direction));
    let coat = distribution_ggx(saturate(dot(normal, half_vector)), roughness)
        * visibility_smith(n_dot_v, n_dot_l, roughness)
        * fresnel_schlick(vec3f(0.04), saturate(dot(view_direction, half_vector)))
        * light.radiance
        * n_dot_l;
    return base * (1.0 - strength * coat_fresnel(normal, view_direction)) + coat * strength;
}

fn ambient_gltf_clearcoat(surface: Surface, ctx: SurfaceContext, extra: vec4f) -> vec3f {
    let normal = normalize(surface.normal);
    let view_direction = normalize(ctx.view_direction);
    let coat_normal = gbuffer_decode_normal(extra.zw);
    let roughness = extra.y;
    let coat_brdf = environment_brdf(saturate(dot(coat_normal, view_direction)), roughness);
    // The base is the library's default ambient, restated here because a
    // model module cannot call the generated one: the environment maps
    // when the frame has them, the analytic hemisphere when not.
    var base: vec3f;
    var coat: vec3f;
    if scene.environment_enabled > 0.0 {
        let brdf = environment_brdf(saturate(dot(normal, view_direction)), surface.roughness);
        let metallic = saturate(surface.metallic);
        let f0 = mix(vec3f(0.04), surface.base_color, metallic);
        base = (surface.base_color * (1.0 - metallic) * environment_diffuse_radiance(normal)
                * surface.diffuse_occlusion
            + environment_specular_radiance(reflect(-view_direction, normal), surface.roughness)
                * (f0 * brdf.x + vec3f(brdf.y)) * surface.specular_occlusion)
            * scene.environment_scale;
        coat = environment_specular_radiance(reflect(-view_direction, coat_normal), roughness)
            * (0.04 * coat_brdf.x + coat_brdf.y) * surface.specular_occlusion
            * scene.environment_scale;
    } else {
        base = ambient_environment(normal, view_direction, surface.base_color,
            surface.metallic, surface.roughness, scene.ambient_sky, scene.ambient_ground,
            environment_brdf(saturate(dot(normal, view_direction)), surface.roughness));
        // A black dielectric is the coat's specular term alone.
        coat = ambient_environment(coat_normal, view_direction, vec3f(0.0), 0.0, roughness,
            scene.ambient_sky, scene.ambient_ground, coat_brdf);
    }
    let strength = extra.x;
    return base * (1.0 - strength * coat_fresnel(coat_normal, view_direction)) + coat * strength;
}
