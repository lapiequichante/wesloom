// PRT diffuse occlusion
//
// The share of the environment's diffuse light that reaches a point, per
// channel, from a grayscale precomputed radiance transfer bake (ADR 0092).
// Feed it to the surface's `diffuse_occlusion`.
//
// The transfer is the point's cosine-weighted visibility projected onto
// order-3 spherical harmonics, plus the light its surroundings bounce
// onto it when the bake traced bounces. `wxsl-prt` packs it into the two
// streams `prt0` and `prt1` (see `lighting.prt_unpack`). `sh0`..`sh8` are
// the environment's radiance in the same basis, as
// `wxsl_prt::sh::project_equirect` computes them. The answer is the
// transferred irradiance over the unshadowed one at `normal`, so the
// environment's scale cancels and the cube keeps its own resolution.
// Shadowing alone keeps it under 1; bounced light can lift it above.
//
// Original implementation.

import package::lighting::prt_unpack::prt_unpack;
import package::lighting::sh_irradiance::sh_irradiance;

fn prt_diffuse_occlusion(
    prt0: vec4f,   // The bake's first stream. @default 0.0
    prt1: vec4f,   // The bake's second stream. @default 0.0
    normal: vec3f, // The normal the bake used: the geometric one. @default 0.0, 1.0, 0.0
    sh0: vec3f,    // Environment radiance, band 0. @default 0.0
    sh1: vec3f,    // Band 1, m = -1 (y). @default 0.0
    sh2: vec3f,    // Band 1, m = 0 (z). @default 0.0
    sh3: vec3f,    // Band 1, m = 1 (x). @default 0.0
    sh4: vec3f,    // Band 2, m = -2 (xy). @default 0.0
    sh5: vec3f,    // Band 2, m = -1 (yz). @default 0.0
    sh6: vec3f,    // Band 2, m = 0 (3z² - 1). @default 0.0
    sh7: vec3f,    // Band 2, m = 1 (xz). @default 0.0
    sh8: vec3f,    // Band 2, m = 2 (x² - y²). @default 0.0
) -> vec3f {
    let t01 = prt_unpack(prt0.z);
    let t23 = prt_unpack(prt0.w);
    let t45 = prt_unpack(prt1.x);
    let t67 = prt_unpack(prt1.y);
    let t8 = prt_unpack(prt1.z);
    let transferred = sh0 * t01.x + sh1 * t01.y + sh2 * t23.x + sh3 * t23.y
        + sh4 * t45.x + sh5 * t45.y + sh6 * t67.x + sh7 * t67.y + sh8 * t8.x;
    let open = sh_irradiance(normal, sh0, sh1, sh2, sh3, sh4, sh5, sh6, sh7, sh8);
    // A channel the environment barely lights has no ratio to speak of.
    return select(
        clamp(transferred / max(open, vec3f(1e-6)), vec3f(0.0), vec3f(4.0)),
        vec3f(1.0),
        open <= vec3f(1e-6),
    );
}
