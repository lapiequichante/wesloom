// Thin-film iridescence
//
// The spectral reflectance of a thin film over a base surface: Snell's
// refraction into the film, Fresnel amplitudes at both interfaces, the
// phase inversions, and the two harmonic terms of the Fourier-space
// XYZ-sensitivity integration — the full evaluation, not a stand-in.
// The result is the film's RGB reflectance modifier: a material mixes
// its F0 toward this response (the glTF KHR_materials_iridescence
// spelling, `mix(f0, response * f0, strength)`); a model-level channel
// is future work (the guide's S2-D), so this node is the honest surface
// term, and `thin_film_phase` is the one scalar term of it.
//
// Zero thickness returns the base interface's own white — the film's
// IOR fades out with the thickness — and total internal reflection
// inside the film returns full reflectance. Out-of-gamut results are
// clamped at zero, as upstream clamps them; the response is not
// energy-preserving beyond that.
//
// SPDX-License-Identifier: Apache-2.0
// Copyright © 2019-2026 The Khronos Group Inc.
// Ported from: https://github.com/KhronosGroup/glTF-Sample-Renderer
// Source: source/Renderer/shaders/iridescence.glsl
// Revision: 0686eb22dc86ecfdd1e0fc93a141b50edac4a706
// Symbol: evalIridescence, with Fresnel0ToIor, IorToFresnel0 and
//         evalSensitivity inlined (a node source is one function).
// Changes: GLSL to WXSL; the outside IOR fixed at 1.0 (the air interface
//          upstream assumes); the m = 1..2 harmonic loop kept and the
//          sensitivity evaluation written once inside it; Schlick's
//          reflectance written in F0 form; socket metadata.
// License text: ../../NOTICE.
fn iridescence(
    base_f0: vec3f,    // The base surface's F0 reflectance. @default 0.04, 0.04, 0.04
    cos_theta: f32,    // Cosine of the view angle against the normal. @default 1.0
    thickness_nm: f32, // Film thickness, nanometres. @default 300.0
    film_ior: f32,     // The film's IOR, 1..3; 1 is the air interface. @default 1.3
) -> vec3f {
    let xyz_to_rec709 = mat3x3f(
        3.2404542, -0.9692660, 0.0556434,
        -1.5371385, 1.8760108, -0.2040259,
        -0.4985314, 0.0415560, 1.0572252,
    );
    let outside_ior = 1.0;
    let nv = clamp(cos_theta, 0.0, 1.0);
    let thickness = max(thickness_nm, 0.0);

    // The film's interface fades in with thickness, so a zero-thickness
    // film is no film: the response is the unmodulated interface white.
    let ior = mix(outside_ior, clamp(film_ior, 1.0, 3.0), smoothstep(0.0, 0.03, thickness));
    // Snell: the cosine on the base layer, inside the film.
    let ratio = outside_ior / ior;
    let cos_theta2_sq = 1.0 - ratio * ratio * (1.0 - nv * nv);
    if (cos_theta2_sq < 0.0) {
        // Total internal reflection at the first interface: the film
        // mirrors whatever light reaches it.
        return vec3f(1.0);
    }
    let cos_theta2 = sqrt(cos_theta2_sq);

    // First interface, air/film. Schlick in F0 form.
    let r0 = (ior - outside_ior) / (ior + outside_ior);
    let reflectance = r0 * r0;
    let r12 = reflectance + (1.0 - reflectance) * pow(1.0 - nv, 5.0);
    let t121 = 1.0 - r12;
    let phi12 = select(0.0, 3.14159265358979323846, ior < outside_ior);
    let phi21 = 3.14159265358979323846 - phi12;

    // Second interface, film/base, per channel. The base F0 is guarded
    // away from 1 so its IOR stays finite.
    let base_ior = (vec3f(1.0) + sqrt(clamp(base_f0, vec3f(0.0), vec3f(0.9999))))
        / (vec3f(1.0) - sqrt(clamp(base_f0, vec3f(0.0), vec3f(0.9999))));
    let r1 = (base_ior - vec3f(ior)) / (base_ior + vec3f(ior));
    let schlick_f0 = r1 * r1;
    let r23 = schlick_f0 + (vec3f(1.0) - schlick_f0) * pow(1.0 - cos_theta2, 5.0);
    var phi23 = vec3f(0.0);
    if (base_ior.x < ior) {
        phi23.x = 3.14159265358979323846;
    }
    if (base_ior.y < ior) {
        phi23.y = 3.14159265358979323846;
    }
    if (base_ior.z < ior) {
        phi23.z = 3.14159265358979323846;
    }

    // Optical path difference across the film, and the phase shifts.
    let opd = 2.0 * ior * thickness * cos_theta2;
    let phase = 2.0 * 3.14159265358979323846 * opd * 1.0e-9;
    let phi = vec3f(phi21) + phi23;

    // Compound terms of the two-interface series.
    let r123 = clamp(r12 * r23, vec3f(1.0e-5), vec3f(0.9999));
    let r123_root = sqrt(r123);
    let rs = t121 * t121 * r23 / (vec3f(1.0) - r123);

    var intensity = r12 + rs;
    var term = rs - t121;
    for (var m = 1; m <= 2; m += 1) {
        term = term * r123_root;
        let scaled = f32(m) * phase;
        let shift = f32(m) * phi;
        // The XYZ sensitivity curves, evaluated in Fourier space at
        // this harmonic's phase, and taken to linear sRGB.
        let val = vec3f(5.4856e-13, 4.4201e-13, 5.2481e-13);
        let pos = vec3f(1.6810e6, 1.7953e6, 2.2084e6);
        let var_scale = vec3f(4.3278e9, 9.3046e9, 6.6121e9);
        var xyz = val * sqrt(2.0 * 3.14159265358979323846 * var_scale)
            * cos(pos * scaled + shift) * exp(-scaled * scaled * var_scale);
        xyz.x += 9.7470e-14 * sqrt(2.0 * 3.14159265358979323846 * 4.5282e9)
            * cos(2.2399e6 * scaled + shift.x) * exp(-4.5282e9 * scaled * scaled);
        xyz /= 1.0685e-7;
        intensity += term * 2.0 * (xyz_to_rec709 * xyz);
    }
    // Out-of-gamut responses clamp at zero, as upstream clamps them.
    return max(intensity, vec3f(0.0));
}
