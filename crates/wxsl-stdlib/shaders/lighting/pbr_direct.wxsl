// PBR direct light
//
// One light's full contribution to a physically-based surface: GGX specular
// plus Lambert diffuse, Fresnel-balanced.
//
// The common case of `pbr_direct_split`: diffuse plus specular. Kept as its
// own function so the frequent case is one node with one output instead of a
// split node plus an add node.

import package::lighting::pbr_direct_split::pbr_direct_split;

fn pbr_direct(
    normal: vec3f,          // Unit shading normal, world space. @default 0.0, 1.0, 0.0
    view_direction: vec3f,  // Unit vector towards the eye. @default 0.0, 0.0, 1.0
    light_direction: vec3f, // Unit vector towards the light. @default 0.0, 1.0, 0.0
    radiance: vec3f,        // The light's radiance, already attenuated for distance. @default 1.0
    base_color: vec3f,      // @default 0.8
    metallic: f32,          // @default 0.0
    roughness: f32,         // @default 0.5
) -> vec3f {
    let split = pbr_direct_split(
        normal,
        view_direction,
        light_direction,
        radiance,
        base_color,
        metallic,
        roughness,
    );
    return split.diffuse + split.specular;
}
