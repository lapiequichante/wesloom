// OKLab to linear sRGB
//
// The inverse of `linear_to_oklab`: OKLab in, linear sRGB out. The result
// is whatever the input demands — a wide-gamut or out-of-range Lab value
// comes back outside sRGB, which is correct and the caller's business.
//
// Technique reference: https://bottosson.github.io/posts/oklab/
fn oklab_to_linear(
    lab: vec3f, // OKLab: L, a, b. @default 0.5, 0.0, 0.0
) -> vec3f {
    let root = vec3f(
        lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z,
        lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z,
        lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z);
    let cube = root * root * root;
    return vec3f(
        dot(cube, vec3f(4.0767416621, -3.3077115913, 0.2309699292)),
        dot(cube, vec3f(-1.2684380046, 2.6097574011, -0.3413193965)),
        dot(cube, vec3f(-0.0041960863, -0.7034186147, 1.7076147010)));
}
