// Linear sRGB to OKLab
//
// Linear sRGB in, OKLab out: L in 0..1 for the display range, a and b
// unbounded and centred on grey.
//
// The coefficients are the OKLab definition (Björn Ottosson, 2020; the
// matrices were corrected in 2021). Values outside the gamut are carried,
// not clamped — the signed cube root is what keeps a negative input
// meaningful, so do not clamp HDR colour on the way in.
//
// Technique reference: https://bottosson.github.io/posts/oklab/
fn linear_to_oklab(
    rgb: vec3f, // Linear sRGB. @default 0.0, 0.0, 0.0
) -> vec3f {
    let lms = vec3f(
        dot(rgb, vec3f(0.4122214708, 0.5363325363, 0.0514459929)),
        dot(rgb, vec3f(0.2119034982, 0.6806995451, 0.1073969566)),
        dot(rgb, vec3f(0.0883024619, 0.2817188376, 0.6299787005)));
    let root = sign(lms) * pow(abs(lms), vec3f(1.0 / 3.0));
    return vec3f(
        dot(root, vec3f(0.2104542553, 0.7936177850, -0.0040720468)),
        dot(root, vec3f(1.9779984951, -2.4285922050, 0.4505937099)),
        dot(root, vec3f(0.0259040371, 0.7827717662, -0.8086757660)));
}
