// AgX tonemap
//
// Maps unbounded positive radiance into 0..1 the AgX way: into Rec. 2020,
// through AgX's inset matrix, onto a log2 range of 16.5 stops around
// middle grey, then a sigmoid, the outset matrix and back to linear
// Rec. 709. Saturated highlights desaturate towards white as they
// brighten instead of skewing hue, and shadows keep their colour; flatter
// and less saturated than ACES in the midtones.
//
// This is the fit three.js ships (Filament's, after Blender's AgX, with
// the iolite polynomial for the sigmoid, no look), not Blender's full
// transform: it is a curve, and like `tonemap_aces` it does no sRGB
// encoding — the display transform owns that.
//
// SPDX-License-Identifier: MIT
// Copyright © 2010-2026 three.js authors
// Ported from: https://github.com/mrdoob/three.js
// Source: src/renderers/shaders/ShaderChunk/tonemapping_pars_fragment.glsl.js
// Revision: 8d486d4cc1a2b420b2585ea52a3e0f783c919282
// Symbol: AgXToneMapping (with agxDefaultContrastApprox and the Rec. 2020
//         matrices inlined)
// Changes: GLSL to WXSL; exposure a parameter rather than a uniform;
//          matrices in WGSL column order as upstream wrote them;
//          the sigmoid and the colour space matrices inlined into the one
//          function a node may declare.
// License text: ../../NOTICE.
fn tonemap_agx(
    color: vec3f, // Linear radiance, unbounded positive. @default 1.0, 1.0, 1.0
    exposure: f32, // Multiplies the radiance before the curve; 2.0 is one stop brighter. @default 1.0
) -> vec3f {
    // Linear Rec. 709 => linear Rec. 2020, and back.
    let srgb_to_rec2020 = mat3x3f(
        0.6274, 0.0691, 0.0164,
        0.3293, 0.9195, 0.0880,
        0.0433, 0.0113, 0.8956);
    let rec2020_to_srgb = mat3x3f(
        1.6605, -0.1246, -0.0182,
        -0.5876, 1.1329, -0.1006,
        -0.0728, -0.0083, 1.1187);
    let inset = mat3x3f(
        0.856627153315983, 0.137318972929847, 0.11189821299995,
        0.0951212405381588, 0.761241990602591, 0.0767994186031903,
        0.0482516061458583, 0.101439036467562, 0.811302368396859);
    // Generated from Filament's inverse of the outset.
    let outset = mat3x3f(
        1.1271005818144368, -0.1413297634984383, -0.14132976349843826,
        -0.11060664309660323, 1.157823702216272, -0.11060664309660294,
        -0.016493938717834573, -0.016493938717834257, 1.2519364065950405);
    // log2(2^-10 * 0.18) and log2(2^6.5 * 0.18).
    let min_ev = -12.47393;
    let max_ev = 4.026069;

    var x = inset * (srgb_to_rec2020 * (color * exposure));
    // Log2 encoding, away from zero and negatives.
    x = log2(max(x, vec3f(1e-10)));
    x = saturate((x - vec3f(min_ev)) / (max_ev - min_ev));

    // The sigmoid, as iolite's sixth-degree polynomial.
    let x2 = x * x;
    let x4 = x2 * x2;
    x = 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - vec3f(0.00232);

    x = outset * x;
    // Linearize.
    x = pow(max(x, vec3f(0.0)), vec3f(2.2));
    // Gamut mapping: a plain clamp, as upstream.
    return saturate(rec2020_to_srgb * x);
}
