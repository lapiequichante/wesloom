// Fractal noise (3D)
//
// Octaves of value noise summed at rising frequency and falling amplitude,
// normalized to 0..1. The octave count is the macro variable
// `WXSL_FBM_OCTAVES`, and `wxsl_fbm_ridged` switches the octaves to ridges —
// both change which code is compiled, not what a socket carries.
//
// This function is where macro variables earn their keep. The octave count
// is a loop bound, so it *must* be a compile-time constant — it cannot be a
// socket carrying a runtime value. It is declared here with a default, and
// a graph or a single node can override it, so changing it in the node
// format recompiles this loop rather than branching at runtime.
//
// `wxsl_fbm_ridged` is a flag macro: with it enabled the octaves are
// folded into ridges (`1 - |2n - 1|`), which turns soft billows into the
// creased look wanted for rock and cloth. Conditional translation drops the
// unused arm entirely, so neither variant pays for the other.

import package::generative::value_noise3::value_noise3;

@macro const WXSL_FBM_OCTAVES: i32 = 5; // How many octaves of noise to sum. A loop bound, so it is a compile-time constant.
@macro const wxsl_fbm_ridged: bool = false; // Fold each octave into a ridge, for a creased look.

fn fbm3(
    p: vec3f,        // @default 0.0
    lacunarity: f32, // Frequency multiplier per octave. @default 2.0
    gain: f32,       // Amplitude multiplier per octave. @default 0.5
) -> f32 {
    var position = p;
    var amplitude = 1.0;
    var total = 0.0;
    var normalization = 0.0;

    for (var octave = 0i; octave < WXSL_FBM_OCTAVES; octave = octave + 1i) {
        var sample = value_noise3(position);
        @if(wxsl_fbm_ridged)
        sample = 1.0 - abs(sample * 2.0 - 1.0);

        total = total + sample * amplitude;
        normalization = normalization + amplitude;
        position = position * lacunarity;
        amplitude = amplitude * gain;
    }

    // A zero octave count is legal and means "no detail"; return the mid
    // value rather than dividing by zero.
    if normalization <= 0.0 {
        return 0.5;
    }
    return total / normalization;
}
