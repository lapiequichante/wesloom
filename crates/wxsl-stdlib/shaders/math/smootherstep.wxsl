// Quintic smoothstep: like `smoothstep`, with a continuous second derivative.
//
// Worth the extra multiply wherever the first derivative's discontinuity
// shows up as a visible crease — noise interpolation, or a value driving a
// normal.
//
// One template over every float width (ADR 0012). The degenerate case — the
// two edges coinciding — is chosen with `select` rather than an `if`, because
// for the vector types `abs(span) < 1e-8` is a `vec<bool>` and `if` demands a
// scalar; per component is the better semantics anyway, since one collapsed
// component should not decide the others. The discarded branch's division by
// zero is discarded with it.

fn smootherstep<T: f32 | vec2f | vec3f | vec4f>(edge0: T, edge1: T, x: T) -> T {
    let span = edge1 - edge0;
    let t = saturate((x - edge0) / span);
    let ramp = t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    let edge = select(T(0.0), T(1.0), x >= edge1);
    return select(edge, ramp, abs(span) >= T(1e-8));
}
