// Normalize a vector, returning zero instead of NaN for a zero-length input.
//
// `normalize` on a zero vector is a division by zero; the NaN then spreads
// through everything downstream and shows up as black or missing pixels far
// from the node that caused it.
//
// One body per width, because WGSL has no user-function overloading. The
// `_<type>` suffix is the convention for a function the node registry
// instantiates per type — `registry.rs` builds these names in one place, and
// `shaders.rs` asserts each one exists. The guard is a scalar `if` rather
// than the `select` the range operators use, and legitimately so: `dot(v, v)`
// is a scalar however wide `v` is, so there is nothing per-component to
// decide.

fn safe_normalize_vec2f(v: vec2f) -> vec2f {
    let length_squared = dot(v, v);
    if length_squared < 1e-12 {
        return vec2f(0.0);
    }
    return v * inverseSqrt(length_squared);
}

fn safe_normalize_vec3f(v: vec3f) -> vec3f {
    let length_squared = dot(v, v);
    if length_squared < 1e-12 {
        return vec3f(0.0);
    }
    return v * inverseSqrt(length_squared);
}

fn safe_normalize_vec4f(v: vec4f) -> vec4f {
    let length_squared = dot(v, v);
    if length_squared < 1e-12 {
        return vec4f(0.0);
    }
    return v * inverseSqrt(length_squared);
}
