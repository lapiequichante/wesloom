{
  "name": "pbr cube",

  "//": [
    "The node format. `macros` pins macro variables: WXSL_FBM_OCTAVES is a",
    "loop bound inside generative/fbm3.wesl and wxsl_fbm_ridged is an @if",
    "flag in the same file, so changing either recompiles the shader rather",
    "than switching a runtime branch. wxsl_tonemap and wxsl_debug_normals",
    "are honoured by the shader ABI itself; they are pinned here to show that",
    "any macro name can be set from the format, declared by a node or not.",
    "",
    "Node ids are stable and edges refer to them, so nodes can be added and",
    "removed without renumbering anything. `label` and `color` are this",
    "node's own — every node is the same colour until one says otherwise, so",
    "a colour marks what a part of the graph is *for* (the two nodes making",
    "the ember glow below are warm) rather than restating what kind of node",
    "it is. `params` are the values on inputs",
    "no edge feeds; an input with neither keeps its definition's default.",
    "`generics` pins the concrete type a generic node (one whose sockets",
    "adapt to whatever they carry, e.g. `math.add` instead of a separate",
    "`math.add.f32`/`.vec3f`/... per type) has resolved to, keyed by the",
    "parameter's name (`T` where one type is shared by every socket).",
    "The operators whose operands WGSL lets differ — `+`, `-`, `*`, `/`,",
    "`%` all spread a scalar over a vector's components, and `*` also",
    "multiplies a matrix by a vector — declare two parameters, `A` and `B`,",
    "resolved separately, with the output derived from both; those nodes",
    "pin both (see ADR 0018).",
    "`wxsl_core::graph::Graph::connect` resolves all of this automatically",
    "as a graph is *built* — but a file like this one is loaded as a whole,",
    "edges and all, never through `connect`, so every generic node spells",
    "its resolution out explicitly instead of leaving it to be inferred",
    "from its edges."
  ],

  "macros": {
    "WXSL_FBM_OCTAVES": { "int": 5 },
    "wxsl_fbm_ridged": { "flag": false },
    "wxsl_tonemap": { "flag": true },
    "wxsl_debug_normals": { "flag": false }
  },

  "nodes": [
    {
      "id": 1,
      "def": "input.world_position",
      "label": "surface point",
      "position": [0.0, 0.0]
    },
    {
      "id": 2,
      "def": "math.multiply",
      "generics": { "A": "vec3", "B": "vec3" },
      "label": "noise scale",
      "params": { "b": { "vec3": [3.0, 3.0, 3.0] } },
      "position": [260.0, 0.0]
    },
    {
      "id": 3,
      "def": "generative.fbm3",
      "label": "surface detail",
      "params": { "lacunarity": { "f32": 2.1 }, "gain": { "f32": 0.55 } },
      "position": [520.0, 0.0]
    },
    {
      "id": 4,
      "def": "math.remap",
      "generics": { "T": "f32" },
      "label": "roughness range",
      "params": {
        "in_min": { "f32": 0.0 },
        "in_max": { "f32": 1.0 },
        "out_min": { "f32": 0.07 },
        "out_max": { "f32": 0.55 }
      },
      "position": [780.0, 0.0]
    },
    {
      "id": 5,
      "def": "const.value",
      "generics": { "T": "vec3" },
      "label": "albedo (sRGB)",
      "params": { "value": { "vec3": [0.95, 0.36, 0.18] } },
      "position": [0.0, 74.0]
    },
    {
      "id": 6,
      "def": "color.srgb_to_linear",
      "label": "to linear light",
      "position": [260.0, 118.0]
    },
    {
      "id": 7,
      "def": "math.step",
      "generics": { "T": "f32" },
      "label": "metal patches",
      "params": { "edge": { "f32": 0.62 } },
      "position": [780.0, 184.0]
    },
    {
      "id": 8,
      "def": "math.multiply",
      "generics": { "A": "f32", "B": "f32" },
      "label": "metallic",
      "params": { "b": { "f32": 0.9 } },
      "position": [1040.0, 0.0]
    },
    {
      "id": 9,
      "def": "input.time",
      "position": [0.0, 170.0]
    },
    {
      "id": 10,
      "def": "animation.pulse",
      "label": "slow breath",
      "params": { "frequency": { "f32": 0.22 }, "phase": { "f32": 0.0 } },
      "position": [260.0, 214.0]
    },
    {
      "id": 11,
      "def": "convert.splat",
      "generics": { "T": "vec3" },
      "position": [520.0, 140.0]
    },
    {
      "id": 12,
      "def": "const.value",
      "generics": { "T": "vec3" },
      "label": "ember colour",
      "color": [0.46, 0.26, 0.16],
      "params": { "value": { "vec3": [0.07, 0.018, 0.005] } },
      "position": [0.0, 244.0]
    },
    {
      "id": 13,
      "def": "math.multiply",
      "generics": { "A": "vec3", "B": "vec3" },
      "label": "emissive",
      "color": [0.46, 0.26, 0.16],
      "position": [780.0, 442.0]
    },
    {
      "id": 14,
      "def": "math.smootherstep",
      "generics": { "T": "f32" },
      "label": "crevice occlusion",
      "params": { "edge0": { "f32": 0.05 }, "edge1": { "f32": 0.75 } },
      "position": [780.0, 302.0]
    },
    {
      "id": 15,
      "def": "output.surface",
      "position": [1300.0, 0.0]
    }
  ],

  "edges": [
    { "from": { "node": 1, "socket": "out" }, "to": { "node": 2, "socket": "a" } },
    { "from": { "node": 2, "socket": "out" }, "to": { "node": 3, "socket": "p" } },
    { "from": { "node": 3, "socket": "out" }, "to": { "node": 4, "socket": "value" } },
    { "from": { "node": 3, "socket": "out" }, "to": { "node": 7, "socket": "x" } },
    { "from": { "node": 3, "socket": "out" }, "to": { "node": 14, "socket": "x" } },
    { "from": { "node": 5, "socket": "out" }, "to": { "node": 6, "socket": "color" } },
    { "from": { "node": 7, "socket": "out" }, "to": { "node": 8, "socket": "a" } },
    { "from": { "node": 9, "socket": "out" }, "to": { "node": 10, "socket": "time" } },
    { "from": { "node": 10, "socket": "out" }, "to": { "node": 11, "socket": "value" } },
    { "from": { "node": 11, "socket": "out" }, "to": { "node": 13, "socket": "a" } },
    { "from": { "node": 12, "socket": "out" }, "to": { "node": 13, "socket": "b" } },
    { "from": { "node": 6, "socket": "out" }, "to": { "node": 15, "socket": "base_color" } },
    { "from": { "node": 8, "socket": "out" }, "to": { "node": 15, "socket": "metallic" } },
    { "from": { "node": 4, "socket": "out" }, "to": { "node": 15, "socket": "roughness" } },
    { "from": { "node": 13, "socket": "out" }, "to": { "node": 15, "socket": "emissive" } },
    { "from": { "node": 14, "socket": "out" }, "to": { "node": 15, "socket": "occlusion" } }
  ]
}
