        } }
      ],
      "edges": [
        { "from": [1, "out"], "to": [2, "v"] },
        { "from": [2, "x"], "to": [3, "x"] },
        { "from": [2, "y"], "to": [3, "z"] },
        { "from": [3, "out"], "to": [5, "sheen_color"] },
        { "from": [2, "x"], "to": [4, "value"] },
        { "from": [4, "out"], "to": [5, "sheen_roughness"] }
      ]
    }
  }],
  "instances": [{ "mesh": 0, "material": 0 }]
