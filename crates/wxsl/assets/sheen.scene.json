{
  "version": 1,
  "abi": 1,
  "name": "graph-authored sheen layer",
  "meshes": [{ "name": "cube", "source": { "kind": "cube", "size": 1.6 } }],
  "materials": [{
    "name": "sheen",
    "model": "wxsl.sheen",
