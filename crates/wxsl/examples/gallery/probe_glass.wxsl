import package::gallery::probe_sample::probe_sample;

fn fresnel(eta_i: f32, eta_t: f32, cosine: f32) -> f32 {
    let ci = clamp(cosine, 0.0, 1.0);
    let k = 1.0 - (eta_i / eta_t) * (eta_i / eta_t) * (1.0 - ci * ci);
    if k <= 0.0 { return 1.0; }
    let ct = sqrt(k);
    let rs = (eta_i * ci - eta_t * ct) / max(eta_i * ci + eta_t * ct, 0.000001);
    let rp = (eta_t * ci - eta_i * ct) / max(eta_t * ci + eta_i * ct, 0.000001);
    return clamp(0.5 * (rs * rs + rp * rp), 0.0, 1.0);
}

// Analytic entry AND exit: a single surface/environment lookup is not a lens.
fn probe_glass(color: texture_cube<f32>, distances: texture_cube<f32>, filtering: sampler,
    position: vec3f, normal: vec3f, view: vec3f, origin: vec3f, scale: f32, sky: texture_cube<f32>) -> vec3f {
    let incident = -normalize(view);
    let n = normalize(position - origin);
    let start = origin + n * 0.85;
    let internal = refract(incident, n, 1.0 / 1.5);
    let thickness = max(-2.0 * dot(start - origin, internal), 0.0);
    let exit = start + internal * thickness;
    let nb = normalize(exit - origin);
    let outgoing = refract(internal, -nb, 1.5);
    let entry_f = fresnel(1.0, 1.5, -dot(incident, n));
    let exit_f = fresnel(1.5, 1.0, dot(internal, nb));
    let reflected = probe_sample(color, distances, filtering, start, reflect(incident, n), origin, sky);
    let exit_light = probe_sample(color, distances, filtering, exit, reflect(internal, -nb), origin, sky);
    var behind = exit_light;
    if dot(outgoing, outgoing) > 0.5 {
        behind = probe_sample(color, distances, filtering, exit, outgoing, origin, sky);
    }
    return (entry_f * reflected + (1.0 - entry_f) *
        ((1.0 - exit_f) * behind + exit_f * exit_light)) * scale;
}
