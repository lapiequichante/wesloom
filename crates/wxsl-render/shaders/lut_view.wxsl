//! lut_view — put a texture on screen, unsampled.
//!
//! The viewer half of the `brdf_lut` proof: a screen effect whose one
//! image input is drawn stretched over the frame's target, red channel
//! for the texel's `x`, green for its `y`. Nothing deep — but it is what
//! lets a demo and a test answer "did the once-only bake leave anything
//! behind?" by looking, and it is one more worked example of an effect
//! declaring exactly one input and the shader declaring exactly one
//! binding for it.

@group(3) @binding(0) var image: texture_2d<f32>;

@vertex
fn view_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle covering the viewport, from three vertices and
    // no vertex buffer: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn view_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let dim = textureDimensions(image);
    // Screen y grows downward; texture v grows up.
    let uv = vec2f(position.x / f32(dim.x), 1.0 - position.y / f32(dim.y));
    let texel = clamp(vec2i(uv * vec2f(dim)), vec2i(0), vec2i(dim) - vec2i(1));
    let value = textureLoad(image, texel, 0).rg;
    // Scale in red, bias in green, over a dim blue so empty texels still
    // read as "something was here".
    return vec4f(value.x, value.y, 0.05, 1.0);
}
