//! bloom — glow for the bright parts of an image.
//!
//! One fullscreen pass over what the previous pass wrote: everything
//! brighter than `THRESHOLD` is kept (with a soft knee, so the effect
//! fades in rather than cutting at a line), blurred with a fixed 13-tap
//! kernel, and added back on top. The input is *linear radiance*, read
//! before the display transform, which is the physically correct place to
//! threshold: a highlight glows because it is brighter than white, not
//! because the curve happened to push it near the top of the encoded
//! range. That became possible when tonemap left `shade_surface`
//! ([ADR 0039](../../../docs/adr/0039-tonemap-is-an-effect-and-ambient-reads-the-lut.md)),
//! and it was the one `const` edit below that the old note promised.
//!
//! Mounted by the `bloom` effect (`wxsl_render::effect`), whose one
//! declared input is this file's only binding: the image, at binding 0 of
//! the pass group. Its three knobs — `threshold`, `knee`, `strength` —
//! are uniforms declared by the descriptor and bound by the pass group at
//! the next binding after the inputs, in a struct generated from that
//! declaration (ADR 0042); this file reads `params.…` and states no
//! struct of its own, because the declaration is the descriptor's and a
//! second copy of it here would be drift. The kernel's *shape* stays
//! `const` — the taps and their weights are the effect's structure, not
//! its tuning surface. The taps are whole texels and the loads clamp to
//! zero off the edge (WebGPU defines out-of-bounds `textureLoad`),
//! because the pass group binds textures and no sampler — a sampler would
//! be a second binding shape for every pass to carry for the one effect
//! that filters.

@group(3) @binding(0) var image: texture_2d<f32>;

/// Texel radius of the kernel's first ring; the second sits at twice it.
const RADIUS: i32 = 4;

/// The kernel's taps, in texels: an inner ring at `RADIUS`, an outer one
/// at twice it, and the diagonals between — thirteen loads covering a
/// disc, which for something this blurry is a Gaussian for government
/// work.
const TAPS: array<vec2i, 12> = array(
    vec2i(1, 0), vec2i(-1, 0), vec2i(0, 1), vec2i(0, -1),
    vec2i(2, 0), vec2i(-2, 0), vec2i(0, 2), vec2i(0, -2),
    vec2i(1, 1), vec2i(-1, 1), vec2i(1, -1), vec2i(-1, -1),
);

/// One weight per tap, plus the centre's: they sum to one, so the blur
/// keeps the brightness the threshold handed it.
const WEIGHTS: array<f32, 13> = array(
    0.18,
    0.11, 0.11, 0.11, 0.11,
    0.06, 0.06, 0.06, 0.06,
    0.035, 0.035, 0.035, 0.035,
);

/// The part of `color` that glows: everything at or under the threshold
/// contributes nothing, and the knee eases it in so a highlight crossing
/// the line brightens the glow instead of popping it. The threshold is
/// linear radiance — diffuse white is the line, and what glows is what is
/// brighter than a white surface fully lit, which is what "highlight"
/// means.
fn bright_pass(color: vec3f) -> vec3f {
    let luminance = dot(color, vec3f(0.2126, 0.7152, 0.0722));
    let kept = smoothstep(params.threshold, params.threshold + params.knee, luminance);
    return color * kept;
}

@vertex
fn bloom_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle covering the viewport, from three vertices and
    // no vertex buffer: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn bloom_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let pixel = vec2i(position.xy);
    // The centre of the kernel is the pixel itself: the blur is of the
    // bright signal, and it must include where it came from.
    var blur = bright_pass(textureLoad(image, pixel, 0).rgb) * WEIGHTS[0];
    for (var tap = 0; tap < 12; tap++) {
        let sample = textureLoad(image, pixel + TAPS[tap] * RADIUS, 0).rgb;
        blur += bright_pass(sample) * WEIGHTS[tap + 1];
    }
    let base = textureLoad(image, pixel, 0).rgb;
    return vec4f(base + blur * params.strength, 1.0);
}
