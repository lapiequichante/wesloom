//! drive aberration: the stdlib's `filter.chromatic_aberration` over the
//! linear frame, after the grade and before the tonemap, with its strength
//! a parameter the `aberration` slider sets. The stock
//! `wxsl.chromatic_aberration` is a screen graph, which cannot declare one
//! (ADR 0040).

import package::filter::chromatic_aberration::chromatic_aberration;

@group(3) @binding(0) var color_image: texture_2d<f32>;

@vertex
fn drive_aberration_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn drive_aberration_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let size = vec2f(textureDimensions(color_image));
    let rgb = chromatic_aberration(color_image, position.xy / size, 1.0 / size, params.strength);
    return vec4f(rgb, textureLoad(color_image, vec2i(position.xy), 0).a);
}
