//! drive motion blur: `wxsl.motion_blur`'s gather along each pixel's own
//! velocity, which refuses light from what did not move with the pixel.
//!
//! The camera carries the car along, so the car's velocity is nearly zero
//! while the road under it streams past. The plain gather has a road pixel
//! just behind the car sample back along the road's motion, into the car,
//! and smears the car's colour down the road as a trail. Here a tap that
//! does not move as this pixel does, by direction as much as by length,
//! is something else in front of it, whose light never crossed this
//! pixel during the exposure, and it is left out of the average: the car
//! that stays put, but also what moves on it, a turning wheel, a body
//! part swaying on its springs, whose bright edge would otherwise streak
//! down the road.
//!
//! Only the car's PRT ground occlusion moves with the car. Its isolated
//! factor is divided out before the gather and restored afterwards.
//! Normal-map lighting and world shadows remain in the gathered colour.

@group(3) @binding(0) var color_image: texture_2d<f32>;
@group(3) @binding(1) var velocity_image: texture_2d<f32>;
@group(3) @binding(2) var shadow_image: texture_2d<f32>;

/// The least share of light the shadow is divided by: deeper, the
/// division would only lift noise.
const DARKEST: f32 = 0.02;

/// The frame at `pixel`, the car's contact occlusion divided out.
fn unshadowed(pixel: vec2i) -> vec3f {
    let shadow = max(textureLoad(shadow_image, pixel, 0).r, DARKEST);
    return textureLoad(color_image, pixel, 0).rgb / shadow;
}

/// How far a tap's motion may stray from the pixel's to count whole, and
/// to count at all: by length, in octaves, and by direction, as one less
/// the cosine. By ratio rather than difference, the road's own motion,
/// which perspective stretches fast near the camera, stays in.
const OCTAVES_FROM: f32 = 1.0;
const OCTAVES_TO: f32 = 2.0;
const TURN_FROM: f32 = 0.15;
const TURN_TO: f32 = 0.4;

/// The share of a tap moving by `moved` in the smear of a pixel moving
/// by `own`.
fn kinship(own: vec2f, moved: vec2f) -> f32 {
    let reach = max(length(own), 1e-6);
    let length_moved = max(length(moved), 1e-6);
    let octaves = abs(log2(length_moved / reach));
    let turn = 1.0 - dot(own, moved) / (reach * length_moved);
    return (1.0 - smoothstep(OCTAVES_FROM, OCTAVES_TO, octaves))
        * (1.0 - smoothstep(TURN_FROM, TURN_TO, turn));
}

/// The longest smear, in uv: a bound on what a slow frame's motion asks
/// of the taps.
const MAX_SMEAR: f32 = 0.4;

/// Limit the cost of very long exposures. Below this limit, sample at
/// least once per pixel so fine normal-map highlights do not form echoes.
const MAX_TAPS: i32 = 256;

/// Bilinear radiance, dividing out occlusion before interpolation.
fn sample_color(point: vec2f, last: vec2i) -> vec3f {
    let base = vec2i(floor(point));
    let blend = fract(point);
    let a = unshadowed(clamp(base, vec2i(0), last));
    let b = unshadowed(clamp(base + vec2i(1, 0), vec2i(0), last));
    let c = unshadowed(clamp(base + vec2i(0, 1), vec2i(0), last));
    let d = unshadowed(clamp(base + vec2i(1, 1), vec2i(0), last));
    return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y);
}

@vertex
fn drive_motion_blur_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn drive_motion_blur_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let size = vec2f(textureDimensions(color_image));
    let last = vec2i(size) - vec2i(1);
    let pixel = vec2i(position.xy);
    let own = textureLoad(velocity_image, pixel, 0).xy;
    // Half the frame's motion back along its trajectory, as a shutter.
    let unclamped = own * 0.5 * params.strength;
    let motion = unclamped * min(1.0, MAX_SMEAR / max(length(unclamped), 1e-9));
    let taps = clamp(i32(ceil(length(motion * size))) + 1, 2, MAX_TAPS);

    var sum = unshadowed(pixel);
    var weight = 1.0;
    // How far back the path stays in the frame, as a share of it. Off the
    // frame nothing is known, and a tap clamped to the edge would slide
    // along it and gather whatever the edge row holds; the share that
    // does not fit behind is taken ahead instead, so the smear keeps its
    // length and its line.
    let path = motion * size;
    let here = vec2f(pixel);
    let behind = select((vec2f(last) - here) / max(-path, vec2f(1e-6)), here / max(path, vec2f(1e-6)), path > vec2f(0.0));
    let ahead = max(1.0 - min(min(behind.x, behind.y), 1.0), 0.0);
    for (var tap = 1; tap < taps; tap++) {
        let fraction = f32(tap) / f32(taps - 1) - ahead;
        let point = here - path * fraction;
        if (any(point < vec2f(0.0)) || any(point > vec2f(last))) {
            continue;
        }
        let sample_pixel = vec2i(round(point));
        let moved = textureLoad(velocity_image, sample_pixel, 0).xy;
        let accept = kinship(own, moved);
        sum += sample_color(point, last) * accept;
        weight += accept;
    }
    let shadow = max(textureLoad(shadow_image, pixel, 0).r, DARKEST);
    return vec4f(sum / weight * shadow, 1.0);
}
