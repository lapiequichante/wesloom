// Ground
//
// Grass on the flats, rock on the slopes and snow on the high peaks, from
// the world position and normal alone, with a little noise so neither the
// grass nor the boundaries read as flat colour.
import package::generative::value_noise3::value_noise3;

struct Ground {
    base_color: vec3f,
    roughness: f32,
}

fn ground(
    world: vec3f,  // World position, metres. @default 0.0, 0.0, 0.0
    normal: vec3f, // World normal. @default 0.0, 1.0, 0.0
) -> Ground {
    let n = normalize(normal);
    let coarse = value_noise3(world * 0.02);
    let fine = value_noise3(world * 0.6);
    let grass = mix(vec3f(0.035, 0.05, 0.02), vec3f(0.07, 0.075, 0.03), coarse) * (0.8 + 0.4 * fine);
    let rock = vec3f(0.11, 0.1, 0.095) * (0.7 + 0.6 * fine);
    let snow = vec3f(0.75, 0.77, 0.8);
    let steep = smoothstep(0.88, 0.7, n.y + 0.1 * (coarse - 0.5));
    var color = mix(grass, rock, steep);
    let snowline = smoothstep(150.0, 190.0, world.y + 30.0 * coarse) * smoothstep(0.55, 0.75, n.y);
    color = mix(color, snow, snowline);
    var out: Ground;
    out.base_color = color;
    out.roughness = mix(0.92, 0.6, snowline);
    return out;
}
