//! drive motion blur, good: `wxsl.motion_blur`'s reconstruction filter
//! (McGuire et al. 2012), its twin but for the car's contact occlusion.
//!
//! Each fragment samples along the longest motion around it, so a
//! railing's fast post smears over the far city as over the concrete,
//! and the depth decides what could have crossed what: the car the camera
//! follows, in front of the road streaming past, leaves no trail on it.
//!
//! Only the car's PRT ground occlusion moves with the car. Its isolated
//! factor is divided out before the gather and restored afterwards.
//! Normal-map lighting and world shadows remain in the gathered colour.

import package::wxsl::bindings::{camera, point_sampler};

@group(3) @binding(0) var color_image: texture_2d<f32>;
@group(3) @binding(1) var velocity_image: texture_2d<f32>;
@group(3) @binding(2) var depth_image: texture_2d<f32>;
@group(3) @binding(3) var neighbors_image: texture_2d<f32>;
@group(3) @binding(4) var shadow_image: texture_2d<f32>;

/// The least share of light the shadow is divided by: deeper, the
/// division would only lift noise.
const DARKEST: f32 = 0.02;

/// The frame at `pixel`, the car's contact occlusion divided out.
fn unshadowed(pixel: vec2i) -> vec3f {
    let shadow = max(textureLoad(shadow_image, pixel, 0).r, DARKEST);
    return textureLoad(color_image, pixel, 0).rgb / shadow;
}

/// The longest smear, in uv: a bound on what a slow frame's motion asks
/// of the taps, and on how far `wxsl.motion_neighbors` looks: its twin.
const MAX_SMEAR: f32 = 0.2;

/// Limit the cost of very long exposures. Below this limit, sample at
/// least once per pixel so fine highlights do not form echoes.
const MAX_TAPS: i32 = 256;

/// How far apart two depths may be, as a share of the nearer, and still
/// be one surface.
const SOFT_DEPTH: f32 = 0.05;

/// The smear's length for a velocity, in pixels: the motion over the
/// shutter, the last half of the frame at full `strength`.
fn smear(motion: vec2f, size: vec2f) -> vec2f {
    let radius = motion * 0.5 * params.strength;
    return radius * min(1.0, MAX_SMEAR / max(length(radius), 1e-9)) * size;
}

/// The view depth of what `pixel` shows, and how much it grew over the
/// last frame, as if it stood still in the world.
fn depth_at(pixel: vec2i, size: vec2f) -> vec2f {
    let depth = textureSampleLevel(depth_image, point_sampler, (vec2f(pixel) + 0.5) / size, 0.0).x;
    let uv = (vec2f(pixel) + 0.5) / size;
    let world = camera.inverse_view_proj * vec4f(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    let point = vec4f(world.xyz / world.w, 1.0);
    let now = (camera.view_proj * point).w;
    return vec2f(now, now - (camera.previous_view_proj * point).w);
}

/// How `1 / depth` changes per pixel on the surface `pixel` shows, from
/// whichever neighbour on each axis is nearer in depth, so as not to
/// reach across an edge: plane, `1 / depth` is linear on screen.
fn inverse_depth_slope(pixel: vec2i, inverse: f32, size: vec2f, last: vec2i) -> vec2f {
    var slope = vec2f(0.0);
    for (var axis = 0; axis < 2; axis++) {
        var step = vec2i(0);
        step[axis] = 1;
        let ahead = 1.0 / depth_at(min(pixel + step, last), size).x - inverse;
        let behind = inverse - 1.0 / depth_at(max(pixel - step, vec2i(0)), size).x;
        slope[axis] = select(behind, ahead, abs(ahead) < abs(behind));
    }
    return slope;
}

/// How clearly `near` is in front of `far`: 0 for one surface or
/// behind, 1 well in front.
fn in_front(near: f32, far: f32) -> f32 {
    return clamp((far - near) / (SOFT_DEPTH * min(near, far)) - 1.0, 0.0, 1.0);
}

/// Whether a smear of `radius` covers `distance`, whole to its end.
fn cylinder(distance: f32, radius: f32) -> f32 {
    return 1.0 - smoothstep(0.95 * radius, 1.05 * radius, distance);
}

/// Bilinear radiance at `point`, in pixels, dividing out occlusion before
/// interpolation.
fn sample_color(point: vec2f, last: vec2i) -> vec3f {
    let base = vec2i(floor(point));
    let blend = fract(point);
    let a = unshadowed(clamp(base, vec2i(0), last));
    let b = unshadowed(clamp(base + vec2i(1, 0), vec2i(0), last));
    let c = unshadowed(clamp(base + vec2i(0, 1), vec2i(0), last));
    let d = unshadowed(clamp(base + vec2i(1, 1), vec2i(0), last));
    return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y);
}

@vertex
fn drive_motion_good_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle covering the viewport, from three vertices and
    // no vertex buffer: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn drive_motion_good_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let size = vec2f(textureDimensions(color_image));
    let last = vec2i(size) - vec2i(1);
    let pixel = vec2i(position.xy);
    let shadow = max(textureLoad(shadow_image, pixel, 0).r, DARKEST);
    let own = unshadowed(pixel);

    let tiles = vec2f(textureDimensions(neighbors_image));
    let tile = min(vec2i(vec2f(pixel) * tiles / size), vec2i(tiles) - vec2i(1));
    let around = smear(textureLoad(neighbors_image, tile, 0).xy, size);
    let span = length(around);
    if (span < 0.5) {
        return vec4f(own * shadow, 1.0);
    }
    let own_motion = textureLoad(velocity_image, pixel, 0).xy;
    let own_smear = smear(own_motion, size);
    let radius = length(own_smear);
    let here = depth_at(pixel, size);
    let depth = here.x;
    let slope = inverse_depth_slope(pixel, 1.0 / depth, size, last);

    // Odd, so the centre is the pixel itself, counted apart.
    let taps = clamp(i32(ceil(2.0 * span)) | 1, 3, MAX_TAPS - 1);
    // Weights are shares of the exposure: the pixel's own light for one
    // pixel of its smear, and each tap's for its spacing over the smear
    // that carries it, so a thin fast post covers a still city for its
    // width over its smear, as it did.
    var weight = 1.0 / max(radius, 1.0);
    var sum = own * weight;
    for (var tap = 0; tap < taps; tap++) {
        if (tap == taps / 2) {
            continue;
        }
        // Every other tap along the pixel's own motion (Guertin et al.
        // 2014): where it moves otherwise than what is around, its own
        // surface still smears its own way.
        let along = mix(-1.0, 1.0, (f32(tap) + 0.5) / f32(taps));
        var path = around;
        if (tap % 2 == 1 && radius >= 0.5) {
            path = own_smear;
        }
        let point = vec2f(pixel) + path * along;
        // Off the frame, nothing is known.
        if (any(point < vec2f(0.0)) || any(point > vec2f(last))) {
            continue;
        }
        let other = vec2i(round(point));
        let distance = length(path) * abs(along);
        let other_motion = textureLoad(velocity_image, other, 0).xy;
        let other_smear = smear(other_motion, size);
        let other_radius = length(other_smear);
        let other_depth = depth_at(other, size);
        // The shutter closes now, so a tap's light crossed only what lies
        // behind it on its way; what crossed the pixel came from ahead of
        // it. The velocity is a chord into the past, and a centred
        // shutter would push it into a future it does not describe: the
        // road ahead of a car, receding, would cover the car.
        let to_pixel = vec2f(pixel) - point;
        let behind_tap = select(0.0, 1.0, dot(to_pixel, other_smear) <= 0.0);
        let ahead_of_pixel = select(0.0, 1.0, dot(to_pixel, own_smear) <= 0.0);
        // One surface smears back along its motion, as the trail a light
        // riding with the camera leaves (the car's own on the road under
        // it), not ahead of it, which the texture alone would ask and no
        // eye tells apart.
        let behind_pixel = select(0.0, 1.0, dot(to_pixel, other_smear) >= 0.0);
        // How deep the tap was when it crossed the pixel, as if it stood
        // still in the world.
        let frames = dot(to_pixel, other_smear)
            / max(other_radius * length(other_motion * size), 1e-9);
        let crossing = other_depth.x + other_depth.y * frames;
        // And how deep the pixel's own surface runs where the tap stands:
        // the road just ahead of a car reveals nothing of it, it runs on
        // under the car, and past the horizon behind everything.
        let inverse_there = 1.0 / depth - dot(slope, to_pixel);
        let reaching = select(1e30, 1.0 / inverse_there, inverse_there > 0.0);
        let front = in_front(crossing, depth);
        let back = in_front(max(depth, reaching), other_depth.x);
        let spacing = 2.0 * length(path) / f32(taps);
        let share = spacing
            * (behind_tap * front * cylinder(distance, other_radius) / max(other_radius, 1.0)
                + ahead_of_pixel * back * cylinder(distance, radius) / max(radius, 1.0)
                + behind_pixel * max(1.0 - front - back, 0.0) * cylinder(distance, other_radius)
                    * cylinder(distance, radius) / max(max(radius, other_radius), 1.0));
        sum += sample_color(point, last) * share;
        weight += share;
    }
    return vec4f(sum / weight * shadow, 1.0);
}
