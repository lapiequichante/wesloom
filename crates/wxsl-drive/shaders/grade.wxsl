//! drive grade: the final colour matrix, on the linear frame just before
//! the tonemap (the last place it is still radiance, ADR 0039).
//!
//! Each output channel is a row: `dot(row.xyz, colour) + row.w`, so one
//! matrix holds saturation, white balance and channel mixing, and the w
//! column a lift. `pipeline::grade_rows` builds the rows the frame uses.

@group(3) @binding(0) var color_image: texture_2d<f32>;

@vertex
fn drive_grade_vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    // A fullscreen triangle: (-1,-1), (3,-1), (-1,3).
    let x = f32(i32(index & 1u) * 4 - 1);
    let y = f32(i32(index >> 1u) * 4 - 1);
    return vec4f(x, y, 0.0, 1.0);
}

@fragment
fn drive_grade_fs(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let color = textureLoad(color_image, vec2i(position.xy), 0);
    let graded = vec3f(
        dot(params.red.xyz, color.rgb) + params.red.w,
        dot(params.green.xyz, color.rgb) + params.green.w,
        dot(params.blue.xyz, color.rgb) + params.blue.w,
    );
    return vec4f(max(graded, vec3f(0.0)), color.a);
}
